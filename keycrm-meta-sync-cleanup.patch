+    /**
+     * Synchronizes a complete subset of text meta values identified by key prefix.
+     *
+     * Existing prefixed keys missing from $values are deleted. Values present in
+     * $values are inserted or updated. Meta with other prefixes is not touched.
+     *
+     * @param array<string, string|null> $values
+     * @return array{upserted:int, deleted:int, unchanged:int}
+     */
+    public static function syncTextValuesByPrefix(
+        string $entityType,
+        int $entityId,
+        string $prefix,
+        array $values,
+    ): array {
+        if ($entityId < 1) {
+            throw new InvalidArgumentException('Meta entity ID must be greater than zero.');
+        }
+
+        $prefix = trim($prefix);
+
+        if ($prefix === '') {
+            throw new InvalidArgumentException('Meta key prefix must not be empty.');
+        }
+
+        $normalizedValues = [];
+
+        foreach ($values as $key => $value) {
+            $key = trim((string)$key);
+
+            if ($key === '' || !str_starts_with($key, $prefix)) {
+                continue;
+            }
+
+            $normalizedValues[$key] = self::normalizeTextValue($value);
+        }
+
+        return static::getDb()->transaction(function () use (
+            $entityType,
+            $entityId,
+            $prefix,
+            $normalizedValues,
+        ): array {
+            /** @var self[] $existingRows */
+            $existingRows = static::find()
+                ->forEntity($entityType, $entityId)
+                ->andWhere(['like', 'key', $prefix . '%', false])
+                ->indexBy('key')
+                ->all();
+
+            $stats = [
+                'upserted' => 0,
+                'deleted' => 0,
+                'unchanged' => 0,
+            ];
+
+            foreach ($existingRows as $key => $row) {
+                if (array_key_exists((string)$key, $normalizedValues)) {
+                    continue;
+                }
+
+                if ($row->delete() === false) {
+                    throw new DomainException(sprintf(
+                        'Failed to delete stale meta "%s" for %s #%d.',
+                        (string)$row->key,
+                        $entityType,
+                        $entityId,
+                    ));
+                }
+
+                $stats['deleted']++;
+            }
+
+            foreach ($normalizedValues as $key => $value) {
+                $row = $existingRows[$key] ?? null;
+
+                if (!$row instanceof self) {
+                    $row = new self();
+                    $row->entity_type = $entityType;
+                    $row->entity_id = $entityId;
+                    $row->key = $key;
+                } elseif (
+                    $row->value === $value
+                    && $row->value_int === null
+                    && $row->value_decimal === null
+                ) {
+                    $stats['unchanged']++;
+                    continue;
+                }
+
+                $row->value = $value;
+                $row->value_int = null;
+                $row->value_decimal = null;
+
+                if (!$row->save(false)) {
+                    throw new DomainException(sprintf(
+                        'Failed to save meta "%s" for %s #%d.',
+                        $key,
+                        $entityType,
+                        $entityId,
+                    ));
+                }
+
+                $stats['upserted']++;
+            }
+
+            return $stats;
+        });
+    }
+
+    public static function deleteForEntity(string $entityType, int $entityId): int
+    {
+        if ($entityId < 1) {
+            return 0;
+        }
+
+        return static::deleteAll([
+            'entity_type' => $entityType,
+            'entity_id' => $entityId,
+        ]);
+    }
+
     /**
      * @param string[] $keys
      * @return array<string, string|null>
@@ -84,4 +186,15 @@ final class MetaModel extends BaseModel
 
         return $result;
